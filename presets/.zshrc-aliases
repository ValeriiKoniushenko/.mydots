if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
fi

if command -v exa >/dev/null 2>&1; then
    alias ll="exa -l --icons -A --group-directories-first"
else
    alias ll='ls -lhAt'
fi

if command -v batcat >/dev/null 2>&1; then
    alias bat='batcat'
fi

if command -v trash >/dev/null 2>&1; then
    alias rm="trash"
fi

if command -v pacman >/dev/null 2>&1; then
    alias pn="sudo pacman -Sy"
fi

if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    if command -v wl-copy >/dev/null 2>&1; then
        alias copy="wl-copy"
        alias paste="wl-paste" 
    fi
elif [ "$XDG_SESSION_TYPE" = "x11" ]; then
    if command -v xclip >/dev/null 2>&1; then
        alias copy="xclip -sel clip"
        alias paste="xclip -sel clip -o" 
    fi
fi
if command -v tree >/dev/null 2>&1; then
    alias tree="tree -a --dirsfirst -L"
fi

if command -v tesseract >/dev/null 2>&1; then
    alias ocr="paste | tesseract stdin stdout"
fi

if [[ -f ~/.zshrc ]]; then
    alias src="source ~/.zshrc"
fi

if [[ -d ~/workspace ]]; then
    alias cdw="cd ~/workspace"
fi

if [[ -d ~/.config ]]; then
    alias cdc="cd ~/.config"
fi

if [[ -d ~/.shared-config ]]; then
    alias cdsc="cd ~/.config"
fi

alias cdls="cd ~/workspace/Nexium"
alias cdd="cd ~/Downloads"
alias h="history | less"
gcommit() {
  # 1. Check for staged files
  local FILES=$(git diff --cached --name-only 2>/dev/null)
  if [ -z "$FILES" ]; then
    echo "No staged files."
    return 1
  fi

  echo "Staged files:"
  echo "$FILES"

  # 2. Apply clang-format to staged C/C++ files
  local FMT_FILES=$(echo "$FILES" | grep -E '\.(c|cpp|h|hpp|cc|cxx)$')
  if [ -n "$FMT_FILES" ]; then
    echo "\nApplying clang-format..."
    echo "$FMT_FILES" | xargs clang-format -i
    echo "$FMT_FILES" | xargs git add
    echo "Done."
  fi

  # 3. Generate commit message
  echo "\nGenerating commit message..."
  local MSG=$(genmsg.py --silent)

  echo "\nProposed message:\n"
  echo "---"
  echo "$MSG"
  echo "---"

  #echo "\nApprove? [Y/n]"
  #read -r confirm
  #if [[ "$confirm" == "n" || "$confirm" == "N" ]]; then
  #  echo "Enter your commit message:"
  #  read -r MSG </dev/tty
  #fi

  if [ -z "$MSG" ]; then
    echo "Empty message, aborting."
    return 1
  fi

  # 4. Commit
  git commit -m "$MSG"
}
