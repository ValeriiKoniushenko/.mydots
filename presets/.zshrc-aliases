gcommit () {
	local DO_ADD_ALL=0
	local DO_PUSH=0
	local DO_FAST=0

	while getopts ":apf" opt; do
		case $opt in
			a) DO_ADD_ALL=1 ;;
			p) DO_PUSH=1 ;;
			f) DO_FAST=1 ;;
			*) echo "Usage: gcommit [-a] [-p] [-f]"; return 1 ;;
		esac
	done

	if [ "$DO_ADD_ALL" -eq 1 ]
	then
		echo "Staging all changes..."
		git add .
	fi

	local FILES=$(git diff --cached --name-only 2>/dev/null)
	if [ -z "$FILES" ]
	then
		echo "No staged files."
		return 1
	fi
	echo "Staged files:"
	echo "$FILES"

	local MODIFIED_FILES=$(git diff --cached --name-only --diff-filter=M 2>/dev/null)
	local FMT_FILES=$(echo "$MODIFIED_FILES" | grep -E '\.(c|cpp|h|hpp|cc|cxx)$')
	if [ -n "$FMT_FILES" ]
	then
		echo "\nApplying clang-format..."
		echo "$FMT_FILES" | xargs clang-format -i
		echo "$FMT_FILES" | xargs git add
		echo "Done."
	fi

	echo "\nGenerating commit message..."
	local MSG=$(genmsg.py --silent)
	if [ -z "$MSG" ]
	then
		echo "Empty message, aborting."
		return 1
	fi

	if [ "$DO_FAST" -eq 0 ]
	then
		local TMPFILE=$(mktemp /tmp/gcommit_msg.XXXXXX)
		echo "$MSG" > "$TMPFILE"

		${EDITOR:-vim} "$TMPFILE"
		MSG=$(cat "$TMPFILE")
		rm -f "$TMPFILE"

		MSG=$(echo "$MSG" | sed '/^[[:space:]]*$/d')
		if [ -z "$MSG" ]
		then
			echo "Empty message, aborting."
			return 1
		fi
	else
		echo "Message: $MSG"
	fi

	git commit -m "$MSG"

	if [ "$DO_PUSH" -eq 1 ]
	then
		echo "\nPushing..."
		git push
	fi
}
